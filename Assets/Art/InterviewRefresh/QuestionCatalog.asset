  _entries:
  - Role: 0
    Id: planning-1
    Prompt: "\uD575\uC2EC \uC7AC\uBBF8\uB97C \uC5B4\uB5BB\uAC8C \uC815\uD558\uB098\uC694?"
    GoodResponse: "\uD575\uC2EC \uD589\uB3D9\uC744 \uC9E7\uAC8C \uAD6C\uD604\uD558\uACE0
      \uD50C\uB808\uC774 \uBC18\uC751\uC73C\uB85C \uC7AC\uBBF8 \uAC00\uC124\uC744
      \uD655\uC778\uD574\uC694."
    NormalResponse: "\uBE44\uC2B7\uD55C \uAC8C\uC784\uC744 \uCC38\uACE0\uD574 \uD575\uC2EC
      \uD589\uB3D9\uC744 \uC815\uD574\uC694."
    BadResponse: "\uC7AC\uBBF8 \uAE30\uC900\uC740 \uC544\uC9C1 \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
  - Role: 0
    Id: planning-2
    Prompt: "\uAE30\uD68D\uC11C\uB97C \uC5B4\uB5BB\uAC8C \uC804\uB2EC\uD558\uB098\uC694?"
    GoodResponse: "\uADDC\uCE59\uACFC \uC608\uC678, \uD654\uBA74 \uD750\uB984\uC744
      \uC815\uB9AC\uD558\uACE0 \uD568\uAED8 \uAC80\uD1A0\uD574 \uD574\uC11D \uCC28\uC774\uB97C
      \uC904\uC5EC\uC694."
    NormalResponse: "\uADDC\uCE59\uACFC \uD654\uBA74 \uD750\uB984\uC744 \uBB38\uC11C\uB85C
      \uC815\uB9AC\uD574\uC694."
    BadResponse: "\uC0DD\uAC01\uB098\uB294 \uB0B4\uC6A9\uC744 \uB9D0\uB85C \uC804\uB2EC\uD574\uC694."
  - Role: 1
    Id: programming-1
    Prompt: "\uAE30\uB2A5\uC744 \uC5B4\uB5BB\uAC8C \uB098\uB204\uC5B4 \uAD6C\uD604\uD558\uB098\uC694?"
    GoodResponse: "\uCC45\uC784\uACFC \uC758\uC874 \uAD00\uACC4\uB97C \uB098\uB204\uACE0
      \uBCC0\uACBD\uC774 \uB2E4\uB978 \uAE30\uB2A5\uC5D0 \uD37C\uC9C0\uC9C0 \uC54A\uAC8C
      \uAD6C\uC131\uD574\uC694."
    NormalResponse: "\uAE30\uB2A5\uBCC4\uB85C \uCF54\uB4DC\uB97C \uB098\uB204\uC5B4
      \uC791\uC131\uD574\uC694."
    BadResponse: "\uD55C\uACF3\uC5D0 \uBAA8\uC544\uC11C \uC791\uC131\uD574\uC694."
  - Role: 1
    Id: programming-2
    Prompt: "\uBC84\uADF8 \uC6D0\uC778\uC744 \uC5B4\uB5BB\uAC8C \uCC3E\uB098\uC694?"
    GoodResponse: "\uC7AC\uD604 \uC870\uAC74\uC744 \uC881\uD788\uACE0 \uC0C1\uD0DC
      \uBCC0\uD654\uB97C \uCD94\uC801\uD574 \uC6D0\uC778\uC744 \uACE0\uCE5C \uB4A4
      \uAC19\uC740 \uC0C1\uD669\uC744 \uD655\uC778\uD574\uC694."
    NormalResponse: "\uC7AC\uD604\uD55C \uB4A4 \uB85C\uADF8\uB97C \uBCF4\uBA70 \uC6D0\uC778\uC744
      \uCC3E\uC544\uC694."
    BadResponse: "\uCF54\uB4DC\uB97C \uBC14\uAFB8\uB2E4 \uBCF4\uBA74 \uACE0\uCCD0\uC838\uC694."
  - Role: 2
    Id: graphics-1
    Prompt: "\uAC8C\uC784\uC5D0 \uB9DE\uB294 \uD654\uD48D\uC744 \uC5B4\uB5BB\uAC8C
      \uC815\uD558\uB098\uC694?"
    GoodResponse: "\uAC8C\uC784 \uBD84\uC704\uAE30\uC640 \uD50C\uB808\uC774 \uD658\uACBD\uC744
      \uAE30\uC900\uC73C\uB85C \uC2DC\uC548\uC744 \uBE44\uAD50\uD558\uACE0 \uD300\uACFC
      \uBC29\uD5A5\uC744 \uB9DE\uCDB0\uC694."
    NormalResponse: "\uAC8C\uC784 \uBD84\uC704\uAE30\uC5D0 \uB9DE\uB294 \uCC38\uACE0
      \uC790\uB8CC\uB97C \uBAA8\uC544\uC694."
    BadResponse: "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uADF8\uB9BC\uCCB4\uB85C \uADF8\uB824\uC694."
  - Role: 2
    Id: graphics-2
    Prompt: "\uD654\uBA74\uC758 \uAC00\uB3C5\uC131\uC744 \uC5B4\uB5BB\uAC8C \uB192\uC774\uB098\uC694?"
    GoodResponse: "\uD615\uD0DC\uC640 \uBA85\uB3C4 \uB300\uBE44\uB85C \uC2DC\uC120\uC744
      \uC720\uB3C4\uD558\uACE0 \uC2E4\uC81C \uD50C\uB808\uC774 \uD654\uBA74\uC5D0\uC11C
      \uAD6C\uBD84\uB418\uB294\uC9C0 \uD655\uC778\uD574\uC694."
    NormalResponse: "\uC911\uC694\uD55C \uC694\uC18C\uAC00 \uBC30\uACBD\uACFC \uAD6C\uBD84\uB418\uAC8C
      \uD574\uC694."
    BadResponse: "\uAFB8\uBBF8\uB294 \uB370 \uC9D1\uC911\uD574\uC694."
  normalMinimum: 3
  goodMinimum: 5
