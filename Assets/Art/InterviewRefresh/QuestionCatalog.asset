  m_Script: {fileID: 11500000, guid: 86f877c5b8b6e3741a1817023877f50e, type: 3}
  m_Name: QuestionCatalog
  m_EditorClassIdentifier: Assembly-CSharp::Ohabjizol.Interview.AuthoredQuestionCatalog
  _entries:
  - Role: 0
    Id: planning-1
    Prompt: "\uD575\uC2EC \uC7AC\uBBF8\uB97C \uC5B4\uB5BB\uAC8C \uC815\uD558\uB098\uC694?"
    GoodResponse: "\uD575\uC2EC \uD589\uB3D9\uC744 \uC9E7\uAC8C \uAD6C\uD604\uD558\uACE0
      \uD50C\uB808\uC774 \uBC18\uC751\uC73C\uB85C \uC7AC\uBBF8 \uAC00\uC124\uC744
      \uD655\uC778\uD574\uC694."
    NormalResponse: "\uBE44\uC2B7\uD55C \uAC8C\uC784\uC744 \uCC38\uACE0\uD574 \uD575\uC2EC
      \uD589\uB3D9\uC744 \uC815\uD574\uC694."
    BadResponse: "\uC7AC\uBBF8 \uAE30\uC900\uC740 \uC544\uC9C1 \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
  - Role: 0
    Id: planning-2
    Prompt: "\uAE30\uD68D\uC11C\uB97C \uC5B4\uB5BB\uAC8C \uC804\uB2EC\uD558\uB098\uC694?"
    GoodResponse: "\uADDC\uCE59\uACFC \uC608\uC678, \uD654\uBA74 \uD750\uB984\uC744
      \uC815\uB9AC\uD558\uACE0 \uD568\uAED8 \uAC80\uD1A0\uD574 \uD574\uC11D \uCC28\uC774\uB97C
      \uC904\uC5EC\uC694."
    NormalResponse: "\uADDC\uCE59\uACFC \uD654\uBA74 \uD750\uB984\uC744 \uBB38\uC11C\uB85C
      \uC815\uB9AC\uD574\uC694."
    BadResponse: "\uC0DD\uAC01\uB098\uB294 \uB0B4\uC6A9\uC744 \uB9D0\uB85C \uC804\uB2EC\uD574\uC694."
  - Role: 0
    Id: planning-3
    Prompt: "\uB09C\uC774\uB3C4\uB97C \uC5B4\uB5BB\uAC8C \uC870\uC815\uD558\uB098\uC694?"
    GoodResponse: "\uC2E4\uD328\uD558\uB294 \uAD6C\uAC04\uACFC \uD559\uC2B5 \uD750\uB984\uC744
      \uAD00\uCC30\uD558\uACE0 \uC870\uC815\uD55C \uB4A4 \uB2E4\uC2DC \uD655\uC778\uD574\uC694."
    NormalResponse: "\uC9C1\uC811 \uD50C\uB808\uC774\uD558\uBA74\uC11C \uC5B4\uB824\uC6B4
      \uAD6C\uAC04\uC744 \uC870\uC815\uD574\uC694."
    BadResponse: "\uC5B4\uB824\uC6B0\uBA74 \uAC10\uC73C\uB85C \uBC14\uAFD4\uC694."
  - Role: 0
    Id: planning-4
    Prompt: "\uD50C\uB808\uC774 \uC758\uACAC\uC744 \uC5B4\uB5BB\uAC8C \uBC18\uC601\uD558\uB098\uC694?"
    GoodResponse: "\uC758\uACAC\uC758 \uC6D0\uC778\uC744 \uD50C\uB808\uC774 \uAE30\uB85D\uACFC
      \uBE44\uAD50\uD558\uACE0 \uD575\uC2EC \uC7AC\uBBF8\uC5D0 \uB9DE\uB294 \uAC1C\uC120\uC744
      \uD655\uC778\uD574\uC694."
    NormalResponse: "\uBC18\uBCF5\uD574\uC11C \uB098\uC628 \uC758\uACAC\uBD80\uD130
      \uBC18\uC601\uD574\uC694."
    BadResponse: "\uC758\uACAC\uC774 \uB2EC\uB77C\uC11C \uBB34\uC5C7\uC744 \uBC14\uAFC0\uC9C0
      \uBAA8\uB974\uACA0\uC5B4\uC694."
  - Role: 0
    Id: planning-5
    Prompt: "\uC77C\uC815\uC774 \uBD80\uC871\uD558\uBA74 \uBB34\uC5C7\uC744 \uC904\uC774\uB098\uC694?"
    GoodResponse: "\uC758\uC874 \uAD00\uACC4\uB97C \uD655\uC778\uD574 \uD575\uC2EC
      \uACBD\uD5D8\uC744 \uBCF4\uC874\uD558\uACE0 \uCD95\uC18C \uBC94\uC704\uB97C
      \uD300\uACFC \uD569\uC758\uD574\uC694."
    NormalResponse: "\uD575\uC2EC \uAE30\uB2A5\uC744 \uB0A8\uAE30\uACE0 \uBD80\uAC00
      \uAE30\uB2A5\uC744 \uC904\uC5EC\uC694."
    BadResponse: "\uAE09\uD55C \uAC83\uBD80\uD130 \uB9CC\uB4E4\uBA74 \uB420 \uAC83
      \uAC19\uC544\uC694."
  - Role: 1
    Id: programming-1
    Prompt: "\uAE30\uB2A5\uC744 \uC5B4\uB5BB\uAC8C \uB098\uB204\uC5B4 \uAD6C\uD604\uD558\uB098\uC694?"
    GoodResponse: "\uCC45\uC784\uACFC \uC758\uC874 \uAD00\uACC4\uB97C \uB098\uB204\uACE0
      \uBCC0\uACBD\uC774 \uB2E4\uB978 \uAE30\uB2A5\uC5D0 \uD37C\uC9C0\uC9C0 \uC54A\uAC8C
      \uAD6C\uC131\uD574\uC694."
    NormalResponse: "\uAE30\uB2A5\uBCC4\uB85C \uCF54\uB4DC\uB97C \uB098\uB204\uC5B4
      \uC791\uC131\uD574\uC694."
    BadResponse: "\uD55C\uACF3\uC5D0 \uBAA8\uC544\uC11C \uC791\uC131\uD574\uC694."
  - Role: 1
    Id: programming-2
    Prompt: "\uBC84\uADF8 \uC6D0\uC778\uC744 \uC5B4\uB5BB\uAC8C \uCC3E\uB098\uC694?"
    GoodResponse: "\uC7AC\uD604 \uC870\uAC74\uC744 \uC881\uD788\uACE0 \uC0C1\uD0DC
      \uBCC0\uD654\uB97C \uCD94\uC801\uD574 \uC6D0\uC778\uC744 \uACE0\uCE5C \uB4A4
      \uAC19\uC740 \uC0C1\uD669\uC744 \uD655\uC778\uD574\uC694."
    NormalResponse: "\uC7AC\uD604\uD55C \uB4A4 \uB85C\uADF8\uB97C \uBCF4\uBA70 \uC6D0\uC778\uC744
      \uCC3E\uC544\uC694."
    BadResponse: "\uCF54\uB4DC\uB97C \uBC14\uAFB8\uB2E4 \uBCF4\uBA74 \uACE0\uCCD0\uC838\uC694."
  - Role: 1
    Id: programming-3
    Prompt: "\uC131\uB2A5 \uBB38\uC81C\uB97C \uC5B4\uB5BB\uAC8C \uD574\uACB0\uD558\uB098\uC694?"
    GoodResponse: "\uCE21\uC815\uC73C\uB85C \uBCD1\uBAA9\uC744 \uCC3E\uACE0 \uBE44\uC6A9\uC744
      \uC904\uC778 \uB4A4 \uAC19\uC740 \uC870\uAC74\uC5D0\uC11C \uD6A8\uACFC\uB97C
      \uBE44\uAD50\uD574\uC694."
    NormalResponse: "\uB290\uB824\uC9C0\uB294 \uBD80\uBD84\uC744 \uCC3E\uC544 \uBD88\uD544\uC694\uD55C
      \uC791\uC5C5\uC744 \uC904\uC5EC\uC694."
    BadResponse: "\uB290\uB9B0 \uBD80\uBD84\uC740 \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
  - Role: 1
    Id: programming-4
    Prompt: "\uB2E4\uB978 \uC9C1\uAD70\uACFC \uC5B4\uB5BB\uAC8C \uD611\uC5C5\uD558\uB098\uC694?"
    GoodResponse: "\uC785\uCD9C\uB825 \uACC4\uC57D\uACFC \uC608\uC678\uB97C \uD569\uC758\uD558\uACE0
      \uC791\uC740 \uAE30\uB2A5\uBD80\uD130 \uC5F0\uACB0\uD574 \uD568\uAED8 \uD655\uC778\uD574\uC694."
    NormalResponse: "\uD544\uC694\uD55C \uB370\uC774\uD130\uC640 \uC0AC\uC6A9\uBC95\uC744
      \uBA3C\uC800 \uB9DE\uCDB0\uC694."
    BadResponse: "\uC644\uC131\uB418\uBA74 \uB2E4\uB978 \uBD84\uAED8 \uC54C\uB824\uC694."
  - Role: 1
    Id: programming-5
    Prompt: "\uAE30\uB2A5 \uBCC0\uACBD\uC5D0 \uC5B4\uB5BB\uAC8C \uB300\uBE44\uD558\uB098\uC694?"
    GoodResponse: "\uBCC0\uACBD \uC9C0\uC810\uC744 \uBD84\uB9AC\uD558\uACE0 \uAE30\uC874
      \uB3D9\uC791\uC744 \uD655\uC778\uD560 \uC218 \uC788\uAC8C \uAD6C\uC131\uD574\uC694."
    NormalResponse: "\uBC14\uB00C\uAE30 \uC26C\uC6B4 \uAC12\uC744 \uB530\uB85C \uAD00\uB9AC\uD574\uC694."
    BadResponse: "\uBC14\uB00C\uBA74 \uC804\uCCB4\uB97C \uB2E4\uC2DC \uC218\uC815\uD574\uC694."
  - Role: 2
    Id: graphics-1
    Prompt: "\uAC8C\uC784\uC5D0 \uB9DE\uB294 \uD654\uD48D\uC744 \uC5B4\uB5BB\uAC8C
      \uC815\uD558\uB098\uC694?"
    GoodResponse: "\uAC8C\uC784 \uBD84\uC704\uAE30\uC640 \uD50C\uB808\uC774 \uD658\uACBD\uC744
      \uAE30\uC900\uC73C\uB85C \uC2DC\uC548\uC744 \uBE44\uAD50\uD558\uACE0 \uD300\uACFC
      \uBC29\uD5A5\uC744 \uB9DE\uCDB0\uC694."
    NormalResponse: "\uAC8C\uC784 \uBD84\uC704\uAE30\uC5D0 \uB9DE\uB294 \uCC38\uACE0
      \uC790\uB8CC\uB97C \uBAA8\uC544\uC694."
    BadResponse: "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uADF8\uB9BC\uCCB4\uB85C \uADF8\uB824\uC694."
  - Role: 2
    Id: graphics-2
    Prompt: "\uD654\uBA74\uC758 \uAC00\uB3C5\uC131\uC744 \uC5B4\uB5BB\uAC8C \uB192\uC774\uB098\uC694?"
    GoodResponse: "\uD615\uD0DC\uC640 \uBA85\uB3C4 \uB300\uBE44\uB85C \uC2DC\uC120\uC744
      \uC720\uB3C4\uD558\uACE0 \uC2E4\uC81C \uD50C\uB808\uC774 \uD654\uBA74\uC5D0\uC11C
      \uAD6C\uBD84\uB418\uB294\uC9C0 \uD655\uC778\uD574\uC694."
    NormalResponse: "\uC911\uC694\uD55C \uC694\uC18C\uAC00 \uBC30\uACBD\uACFC \uAD6C\uBD84\uB418\uAC8C
      \uD574\uC694."
    BadResponse: "\uAFB8\uBBF8\uB294 \uB370 \uC9D1\uC911\uD574\uC694."
  - Role: 2
    Id: graphics-3
    Prompt: "\uC791\uC5C5 \uACFC\uC815\uC744 \uC124\uBA85\uD574 \uC8FC\uC138\uC694."
    GoodResponse: "\uC2E4\uB8E8\uC5E3\uACFC \uAD6C\uB3C4\uB97C \uBA3C\uC800 \uAC80\uD1A0\uD558\uACE0
      \uC911\uAC04 \uD655\uC778\uC744 \uAC70\uCCD0 \uC644\uC131\uD574\uC694."
    NormalResponse: "\uC2A4\uCF00\uCE58\uC640 \uCC44\uC0C9 \uC21C\uC11C\uB85C \uC791\uC5C5\uD574\uC694."
    BadResponse: "\uBC14\uB85C \uC644\uC131 \uADF8\uB9BC\uC744 \uADF8\uB824\uC694."
  - Role: 2
    Id: graphics-4
    Prompt: "\uD53C\uB4DC\uBC31\uC744 \uC5B4\uB5BB\uAC8C \uBC18\uC601\uD558\uB098\uC694?"
    GoodResponse: "\uD53C\uB4DC\uBC31 \uC758\uB3C4\uB97C \uD655\uC778\uD558\uACE0
      \uB300\uC548\uC744 \uBE44\uAD50\uD574 \uC804\uCCB4 \uBC29\uD5A5\uACFC \uB9DE\uAC8C
      \uC218\uC815\uD574\uC694."
    NormalResponse: "\uC694\uCCAD\uBC1B\uC740 \uBD80\uBD84\uC744 \uC218\uC815\uD574\uC694."
    BadResponse: "\uC5B4\uB5BB\uAC8C \uACE0\uCE60\uC9C0 \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
  - Role: 2
    Id: graphics-5
    Prompt: "\uC544\uD2B8 \uC790\uC0B0\uC744 \uC5B4\uB5BB\uAC8C \uC804\uB2EC\uD558\uB098\uC694?"
    GoodResponse: "\uD06C\uAE30\uC640 \uD615\uC2DD, \uAE30\uC900\uC810\uC744 \uB9DE\uCD94\uACE0
      \uAC8C\uC784\uC5D0 \uC801\uC6A9\uD574 \uC798\uB9AC\uB294 \uBD80\uBD84\uACFC
      \uD45C\uD604\uC744 \uD655\uC778\uD574\uC694."
    NormalResponse: "\uD30C\uC77C \uC774\uB984\uACFC \uD06C\uAE30\uB97C \uB9DE\uCDB0
      \uC804\uB2EC\uD574\uC694."
    BadResponse: "\uADF8\uB9BC \uD30C\uC77C\uB9CC \uBCF4\uB0B4\uC694."
  normalMinimum: 3
  goodMinimum: 5
